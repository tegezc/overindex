# Copy to .env.local and fill in locally. Never commit real values.

# Qloo: required in production. Locally, `qloo setup --qloo` is enough.
QLOO_API_KEY=
QLOO_HOME=

# OpenAI: required unless USE_FAKE_QLOO=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium

# Cache for Qloo responses; must live outside the repo or stay git-ignored.
# Default: ./.cache (dev), /data (production)
CACHE_DIR=

QLOO_BUDGET_TARGET=25
QLOO_BUDGET_CAP=40
QLOO_CONCURRENCY=2
LIVE_REPORTS_PER_IP_PER_DAY=3
LIVE_REPORTS_GLOBAL_PER_DAY=50

# true = synthetic Qloo data for UI/tests, no keys required
USE_FAKE_QLOO=false
